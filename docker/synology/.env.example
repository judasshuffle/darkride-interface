COMPOSE_PROJECT_NAME=darkride11-beta
# Replace with the full source SHA emitted by the workflow; never madders-test/latest.
DARKRIDE_IMAGE=ghcr.io/judasshuffle/robotdolly-darkride-server:1.1-beta-REPLACE_WITH_FULL_SHA
# Create a NEW directory; never point at the existing world's directory.
DARKRIDE_DATA_DIR=/volume1/docker/darkride11-beta-data
PUID=10001
PGID=10001
# Starting limit, not measured requirements; leave RAM for DSM.
MEMORY_LIMIT=2g
HTTP_PORT=41100
HTTPS_PORT=41101
DOMAIN_PORT=41102
DTLS_PORT=41103
AC_PORT_BASE=48100
