+# GCC 13 requires the old TBB member's task type to be qualified.
+# Limit this change to the isolated Linux container.
+if(VCPKG_TARGET_IS_LINUX)
+    set(_task_header "${SOURCE_PATH}/include/tbb/task.h")
+    file(READ "${_task_header}" _task_source)
+    string(REPLACE "task* next_offloaded;" "tbb::task* next_offloaded;" _task_fixed "${_task_source}")
+    if(_task_fixed STREQUAL _task_source)
+        message(FATAL_ERROR "Pinned TBB task declaration changed")
+    endif()
+    file(WRITE "${_task_header}" "${_task_fixed}")
+endif()
 file(COPY ${CMAKE_CURRENT_LIST_DIR}/CMakeLists.txt DESTINATION ${SOURCE_PATH})
 
 if (NOT VCPKG_TARGET_IS_WINDOWS)
@@ -133,6 +145,12 @@
 )
 
+# The release-only vcpkg triplet has no debug archives.
+# Make the generated import config use release archives for both.
+if(VCPKG_BUILD_TYPE STREQUAL "release")
+    string(REPLACE "/debug/lib/" "/lib/" _contents "${_contents}")
+    string(REPLACE "_debug.a" ".a" _contents "${_contents}")
+endif()
 string(REPLACE "SHARED IMPORTED)" "UNKNOWN IMPORTED)" _contents "${_contents}")
 file(WRITE ${CURRENT_PACKAGES_DIR}/share/tbb/TBBConfig.cmake "${_contents}")
 
